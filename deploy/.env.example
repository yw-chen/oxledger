# Copy to deploy/.env (not committed) and change the password.
OX_DB_PASSWORD=change-me
# The page is http://localhost:<OX_PORT>; OXLEDGER_SPA_ORIGIN follows it.
OX_PORT=8088
# Google sign-in (optional; deploy/README.md). Both values, or leave both out.
# OX_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# OX_GOOGLE_CLIENT_SECRET=
# Only addresses in these domains may sign in (comma separated; empty: any).
# OX_GOOGLE_ALLOWED_DOMAINS=example.com
# Only these addresses may open a site that has no user yet (empty: anyone
# who signs in first).
# OX_SETUP_EMAILS=you@example.com
