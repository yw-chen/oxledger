{
  "name": "oxledger-web",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --host localhost --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 5174 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --update-snapshots=none"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "^5.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.23.1",
    "jsdom": "^27.0.0",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  }
}
